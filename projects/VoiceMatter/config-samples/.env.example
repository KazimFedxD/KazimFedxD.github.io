# VoiceMatter environment template.
# Copy to .env and replace placeholders with your real values.
# .env is git-ignored. Never commit real secrets.

# Deepgram — speech-to-text
# Get a key at https://console.deepgram.com
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_API_KEY_HERE

# LLM — Anthropic-API-compatible endpoint for transcript formatting
# Example providers: Anthropic, OpenRouter (Anthropic-compatible mode),
# any service implementing /v1/messages with an Anthropic-style body.
MINIMAX_API_KEY=YOUR_MINIMAX_API_KEY_HERE

# Base URL of the Anthropic-API-compatible endpoint.
# Append the API path; e.g. https://api.example.com/anthropic
MINIMAX_BASE_URL=https://api.example.com/anthropic