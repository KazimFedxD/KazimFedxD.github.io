# Backend Environment Variables Template# Database

# Copy this file to .env and fill in your actual valuesDATABASE_URL=postgresql://fincore_user:YOUR_PASSWORD_HERE@localhost:5432/fincore_db



# ============================================# Django

# DATABASE CONFIGURATIONSECRET_KEY=your-secret-key-here-change-in-production

# ============================================DEBUG=True

DATABASE_URL=postgresql://fincore_user:YOUR_STRONG_PASSWORD_HERE@db:5432/fincore_dbALLOWED_HOSTS=*



# ============================================# Celery

# DJANGO SECRET KEY (CHANGE IN PRODUCTION!)CELERY_BROKER_URL=redis://localhost:6379/0

# ============================================

# Generate new key: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'# Email (optional for development)

SECRET_KEY=your-secret-key-here-must-be-random-50-plus-characters# EMAIL_HOST=smtp.gmail.com

# EMAIL_PORT=587

# ============================================# EMAIL_USE_TLS=True

# CELERY & REDIS# EMAIL_HOST_USER=your-email@gmail.com

# ============================================# EMAIL_HOST_PASSWORD=your-app-password

CELERY_BROKER_URL=redis://redis:6379/0# DEFAULT_FROM_EMAIL=FinCore <noreply@example.com>



# ============================================# Frontend

# EMAIL CONFIGURATIONREACT_APP_API_URL=http://localhost:8000

# ============================================

# Development: Use console backend (prints emails to terminal)# Docker (for hot-reload)

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackendCHOKIDAR_USEPOLLING=true


# Production: Use SMTP backend (uncomment and configure)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@yourfincore.com
# EMAIL_HOST_PASSWORD=your-app-specific-password-here
# DEFAULT_FROM_EMAIL="FinCore" <noreply@yourfincore.com>

# ============================================
# DJANGO SETTINGS
# ============================================
DEBUG=True
ALLOWED_HOSTS=*

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================
# OPTIONAL: GROQ AI API (Future Feature)
# ============================================
# GROQ_API_KEY=gsk_your_api_key_here

# ============================================
# NOTES
# ============================================
# 1. NEVER commit this file with real values to Git
# 2. In production, use strong passwords (16+ characters)
# 3. Generate new SECRET_KEY (don't use Django default)
# 4. Set DEBUG=False in production
# 5. Restrict ALLOWED_HOSTS to your actual domain(s)
# 6. For Gmail: Use App-Specific Password, not your Gmail password
